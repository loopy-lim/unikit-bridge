{
  "name": "@unikit-bridge/react-native",
  "version": "0.11.0",
  "description": "Type-safe React Native client for unikit — one Rust core over a compact binary wire, with CI contracts that block breaking schema changes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "native/**/*",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist dist-test",
    "test": "bun test src/index.test.ts",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@unikit-bridge/types": "^0.13.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "unikit",
    "react-native",
    "rust",
    "typescript",
    "ffi",
    "jsi",
    "nitro",
    "bindings",
    "type-safe",
    "bridge"
  ],
  "peerDependencies": {
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/unikit.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/unikit/issues"
  },
  "homepage": "https://github.com/loopy-lim/unikit#readme"
}
