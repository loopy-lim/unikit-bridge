{
  "name": "@unikit/bun",
  "version": "0.11.1",
  "description": "Type-safe Bun client for unikit — one Rust core over a compact binary wire, with CI contracts that block breaking schema changes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist dist-test",
    "test": "bun test src",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@unikit/types": "^0.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "unikit",
    "bun",
    "rust",
    "typescript",
    "ffi",
    "bindings",
    "type-safe",
    "bridge",
    "binary-wire",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/unikit.git",
    "directory": "packages/bun"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/unikit/issues"
  },
  "homepage": "https://github.com/loopy-lim/unikit#readme"
}
