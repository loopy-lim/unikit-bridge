{
  "name": "@unikit-bridge/devtools",
  "version": "0.7.3",
  "description": "Devtools for unikit — instrumented engine with call stats, built on one Rust core with type-safe clients over a compact binary wire.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "bun test src/index.test.ts src/timeline-report.test.ts",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@unikit-bridge/types": "^0.13.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "unikit",
    "devtools",
    "observability",
    "rust",
    "typescript",
    "ffi",
    "bridge",
    "debugging",
    "tracing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/unikit-bridge.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/unikit-bridge/issues"
  },
  "homepage": "https://github.com/loopy-lim/unikit-bridge#readme"
}
