{
  "name": "unikit-bare-rn-calculator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "main": "index.ts",
  "workspaces": [
    "modules/unikit-bridge"
  ],
  "scripts": {
    "codegen": "node ../../packages/rustra/dist/cli/index.js codegen --config unikit.json",
    "codegen:check": "node ../../packages/rustra/dist/cli/index.js codegen --config unikit.json --check",
    "postinstall": "node scripts/link-live-packages.mjs",
    "test:autolink": "bun scripts/check-autolink.mjs",
    "typecheck": "tsc --noEmit",
    "unikit:ios": "node -e \"require('@unikit-bridge/generated-react-native/scripts/prepare-native.cjs').prepare('ios')\"",
    "unikit:android": "node -e \"require('@unikit-bridge/generated-react-native/scripts/prepare-native.cjs').prepare('android')\""
  },
  "dependencies": {
    "@unikit-bridge/generated-react-native": "workspace:*",
    "@unikit-bridge/rustra": "file:../../packages/rustra",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@unikit-bridge/rustra": "file:../../packages/rustra"
  }
}
