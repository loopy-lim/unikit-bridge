{
  "name": "@unikit-bridge/example-rn-experiment",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "generate:schema": "cargo run -p unikit-rn-experiment --bin generate",
    "codegen": "node ../../packages/rustra/dist/cli/index.js codegen --config unikit.json",
    "codegen:check": "node ../../packages/rustra/dist/cli/index.js codegen --config unikit.json --check",
    "test": "bun test apps/benchmark.test.ts apps/native-benchmark.test.ts scripts/benchmark-receipts.test.ts",
    "test:adapter": "bun apps/react-native-app.ts",
    "test:node": "cargo build -p unikit-rn-experiment --bin unikit-rn-experiment && bun apps/node-app.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:native": "tsc --noEmit -p tsconfig.native.json"
  },
  "dependencies": {
    "@unikit-bridge/generated-react-native": "workspace:*",
    "@unikit-bridge/rustra": "file:../../packages/rustra"
  },
  "peerDependencies": {
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "react-native": "0.81.5"
  },
  "workspaces": [
    "modules/unikit-bridge"
  ],
  "overrides": {
    "@unikit-bridge/rustra": "file:../../packages/rustra"
  }
}
