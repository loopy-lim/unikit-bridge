{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/rustra/src/types/index.ts",
    "packages/rustra/src/node/index.ts",
    "packages/rustra/src/bun/index.ts",
    "packages/rustra/src/tauri/index.ts",
    "packages/rustra/src/react-native/index.ts",
    "packages/rustra/src/react/index.ts",
    "packages/rustra/src/testing/index.ts",
    "packages/rustra/src/devtools/index.ts"
  ],
  "out": "docs/api",
  "name": "@unikit-bridge/rustra API Reference",
  "includeVersion": true,
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "entryPointStrategy": "resolve",
  "gitRevision": "main",
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  }
}
